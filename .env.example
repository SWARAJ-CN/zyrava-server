# Copy to `.env` in this folder. Never commit real values.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=

# 32+ random bytes each: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes
ACCESS_TOKEN_TTL=15m
REFRESH_DAYS=7
REMEMBER_DAYS=30

# Comma-separated browser origins allowed to call this API with cookies.
# The same list gates the Socket.IO handshake (/socket.io) used by the chat
# community, so the frontend's exact origin has to appear here — including
# `next dev`'s http://localhost:3000.
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# Admin console (/api/admin)
# ---------------------------------------------------------------------------
# Credentials for the analytics console. Use a long, unique password.
ADMIN_EMAIL=admin@zyrava.app
ADMIN_PASSWORD=change-this-to-a-long-random-password
# Optional: defaults to JWT_ACCESS_SECRET. Use a separate 64-char secret ideally.
ADMIN_JWT_SECRET=
ADMIN_SESSION_HOURS=12

# Allow DELETE /api/admin/users/:id and /api/admin/sessions/:id.
# Set to false for a strictly read-only panel.
ADMIN_ALLOW_DELETE=true

# Dashboard aggregation cache, in milliseconds.
ADMIN_CACHE_TTL_MS=5000

# Optional single-deployment mode: absolute path to the built admin SPA.
# Build it with VITE_BASE=/admin/ and it will be served at /admin.
# ADMIN_CLIENT_DIST=/path/to/zyrava-admin/client/dist

# Optional, only used for display in the admin system page.
ZYRAVA_API_URL=https://zyrava-server.onrender.com

# Optional, for cookies shared across subdomains: .example.com
# COOKIE_DOMAIN=

# Skip boot-time index creation only if the DB user cannot build indexes.
# MONGO_INDEXES=off
